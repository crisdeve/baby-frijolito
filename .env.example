# Template for a per-machine override (copy to .env.local) if you ever want
# a separate Firebase project for local development. The values that ship to
# both `next dev` and GitHub Pages already live in the committed `.env` file
# — you likely don't need this file at all. See README.

# Firebase project config (Project settings > General > Your apps > SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (bot protection) — reCAPTCHA v3 site key
# Firebase Console > App Check > Apps > (this app) > reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Only needed when deploying to GitHub Pages as a project site
# (https://<user>.github.io/<repo>), set to "/<repo>". Leave empty for a
# user/org site (https://<user>.github.io) or a custom domain.
NEXT_PUBLIC_BASE_PATH=
