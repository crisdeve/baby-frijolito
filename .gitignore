# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Firebase web config + reCAPTCHA site key are public by design (safety
# comes from Firestore rules + App Check, not secrecy) — committed so both
# `next dev` and the GitHub Pages build read them with no extra setup.
# (.env.local / .env.*.local stay ignored, for personal per-machine overrides.)
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
